    "\\blearning curve\\b",
    "\\bcan'?t find\\b"
   ]
  },
  {
   "id": "support",
   "label": "Support that does not answer",
   "kind": "complaint",
   "patterns": [
    "\\bcustomer (service|support)\\b",
    "\\bsupport (team|is|was)\\b",
    "\\bno (response|reply)\\b",
    "\\bnever (replied|responded|heard back)\\b",
    "\\bticket\\b",
    "\\bchat ?bot\\b"
   ]
  },
  {
   "id": "account",
   "label": "Login and account problems",
   "kind": "complaint",
   "patterns": [
    "\\blog ?in\\b",
    "\\bsign ?in\\b",
    "\\bpassword\\b",
    "\\blocked out\\b",
    "\\bverification\\b",
    "\\b2fa\\b",
    "\\bdelete (my )?account\\b"
   ]
  },
  {
   "id": "notifications",
   "label": "Notifications and spam",
   "kind": "complaint",
   "patterns": [
    "\\bnotification",
    "\\bspam",
    "\\btoo many emails\\b",
    "\\bpush\\b",
    "\\breminders?\\b"
   ]
  },
  {
   "id": "ads",
   "label": "Ads",
   "kind": "complaint",
   "patterns": [
    "\\bads\\b",
    "\\badvert",
    "\\bad.?supported\\b",
    "\\bpop.?ups?\\b"
   ]
  },
  {
   "id": "updates",
   "label": "A redesign or update made it worse",
   "kind": "complaint",
   "patterns": [
    "\\b(new|latest|recent) (update|version|design)\\b",
    "\\bredesign",
    "\\bused to be\\b",
    "\\bbring back\\b",
    "\\bsince the update\\b"
   ]
  },
  {
   "id": "privacy",
   "label": "Privacy and permissions",
   "kind": "complaint",
   "patterns": [
    "\\bprivacy\\b",
    "\\btracking\\b",
    "\\bsell(s|ing)? (my )?data\\b",
    "\\bpermissions?\\b",
    "\\bcreepy\\b"
   ]
  },
  {
   "id": "integrations",
   "label": "Integrations, import and export",
   "kind": "request",
   "patterns": [
    "\\bintegrat",
    "\\bzapier\\b",
    "\\bgoogle (calendar|sheets|drive)\\b",
    "\\boutlook\\b",
    "\\bslack\\b",
    "\\bapi\\b",
    "\\bexport\\b",
    "\\bimport\\b",
    "\\bcsv\\b",
    "\\bwebhook"
   ]
  },
  {
   "id": "platforms",
   "label": "Platforms, offline and mobile",
   "kind": "request",
   "patterns": [
    "\\boffline\\b",
    "\\bandroid\\b",
    "\\bipad\\b",
    "\\btablet\\b",
    "\\bdesktop app\\b",
    "\\bmac app\\b",
    "\\bwindows\\b",
    "\\bmobile (app|version)\\b",
    "\\bweb version\\b"
   ]
  },
  {
   "id": "customisation",
   "label": "Customisation and control",
   "kind": "request",
   "patterns": [
    "\\bcustomi[sz]",
    "\\bdark mode\\b",
    "\\btheme\\b",
    "\\bbranding\\b",
    "\\bwhite.?label\\b",
    "\\btemplates?\\b",
    "\\bsettings?\\b",
    "\\boption to\\b"
   ]
  },
  {
   "id": "collaboration",
   "label": "Teams and sharing",
   "kind": "request",
   "patterns": [
    "\\bteam(s|mates?)?\\b",
    "\\bshar(e|ing)\\b",
    "\\bcollaborat",
    "\\bmultiple (users|accounts|people)\\b",
    "\\broles?\\b",
    "\\bpermissions for\\b"
   ]
  },
  {
   "id": "swipe_limit",
   "label": "Daily swipe / photo limits",
   "kind": "complaint",
   "patterns": [
    "\\blimit(ed|s)?\\b",
    "\\bswipes? (a|per) day\\b",
    "\\bdaily (limit|swipes?)\\b",
    "\\bonly \\d+ (swipes?|photos?|pictures?)\\b",
    "\\bout of swipes\\b",
    "\\b\\d+ (free )?swipes\\b"
   ]
  },
  {
   "id": "weekly_sub",
   "label": "Weekly subscription / forced trial",
   "kind": "complaint",
   "patterns": [
    "\\bweekly\\b",
    "\\bper week\\b",
    "\\ba week\\b",
    "\\b/ ?week\\b",
    "\\bfree trial\\b",
    "\\btrial\\b",
    "\\blifetime\\b",
    "\\bone.?time (purchase|payment|fee)\\b"
   ]
  },
  {
   "id": "space_not_freed",
   "label": "Space not freed / Recently Deleted confusion",
   "kind": "complaint",
   "patterns": [
    "\\brecently deleted\\b",
    "\\bstorage (didn'?t|did not|hasn'?t|not)\\b",
    "\\bdidn'?t free\\b",
    "\\bspace (wasn'?t|isn'?t|not) (freed|cleared)\\b",
    "\\bstill (in|on) my (phone|camera roll|photos)\\b"
   ]
  },
  {
   "id": "wrong_delete",
   "label": "Deleted the wrong photos / no undo",
   "kind": "complaint",
   "patterns": [
    "\\bundo\\b",
    "\\baccident(al|ally)?\\b",
    "\\bwrong (photo|picture)s?\\b",
    "\\bdeleted (all|everything|my)\\b",
    "\\blost (my|all|photos|pictures)\\b",
    "\\bcan'?t (get|recover) (them|it|my)\\b"
   ]
  },
  {
   "id": "progress_lost",
   "label": "Progress resets / sees same photos again",
   "kind": "complaint",
   "patterns": [
    "\\bstart(s|ed)? over\\b",
    "\\breset(s|ting)?\\b",
    "\\bsame (photos|pictures) (again|over)\\b",
    "\\blost (my )?progress\\b",
    "\\bkeeps? showing\\b",
    "\\bshows? (me )?(the )?same\\b"
   ]
  },
  {
   "id": "slow_load",
   "label": "Slow loading / blurry / iCloud photos",
   "kind": "complaint",
   "patterns": [
    "\\bslow\\b",
    "\\bloading\\b",
    "\\blag(gy|s)?\\b",
    "\\bblurr?y\\b",
    "\\bicloud\\b",
    "\\bfreez(e|es|ing)\\b"
   ]
  },
  {
   "id": "videos",
   "label": "Videos / Live Photos handling",
   "kind": "request",
   "patterns": [
    "\\blive photos?\\b",
    "\\bvideos? (too|as well|support|aren'?t|don'?t|won'?t|doesn'?t)\\b",
    "\\b(delete|deleting|sort|sorting|swipe|swiping|see|play|playing|view|viewing|include|includes|including|clean)\\s+(my |the |through )?videos?\\b",
    "\\bphotos? (and|&|or) videos?\\b"
   ]
  },
  {
   "id": "duplicates",
   "label": "Duplicates / similar photo detection",
   "kind": "request",
   "patterns": [
    "\\bduplicates?\\b",
    "\\bsimilar\\b",
    "\\bcompare\\b",
    "\\bburst\\b"
   ]
  },
  {
   "id": "organize",
   "label": "Sort by month / albums / organize into folders",
   "kind": "request",
   "patterns": [
    "\\balbums?\\b",
    "\\bfolders?\\b",
    "\\bby (month|year|date)\\b",
    "\\b(each|every|a|one|per) month at a time\\b",
    "\\bmonth by month\\b",
    "\\bcategor"
   ]
  },
  {
   "id": "cant_delete",
   "label": "Deleting stops working / photos not actually removed",
   "kind": "complaint",
   "patterns": [
    "\\b(won'?t|doesn'?t|didn'?t|does not|did not|unable to|can'?t|cannot) (let me )?(actually )?delete\\b",
    "\\bstopped deleting\\b",
    "\\bdidn'?t get rid of\\b",
    "\\bnot (actually )?deleted\\b"
   ]
  },
  {
   "id": "early_review",
   "label": "Asks for a rating / review too early",
   "kind": "complaint",
   "patterns": [
    "\\b(asking|asked|ask) (me )?for (a )?(rating|review)\\b",
    "\\breview before\\b",
    "\\brate (the|this) app before\\b",
    "\\bduring onboarding\\b"
   ]
  }
 ]
}