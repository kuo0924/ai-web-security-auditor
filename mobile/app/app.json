{
  "expo": {
    "name": "Photo Swipe",
    "slug": "photo-swipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tw.photoswipe.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "需要讀取相簿，才能讓你逐張滑動整理照片。照片只在手機上處理，不會上傳。",
        "NSPhotoLibraryAddUsageDescription": "需要相簿權限來整理照片。",
        "NSFaceIDUsageDescription": "用 Face ID 解鎖上鎖相簿。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tw.photoswipe.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sqlite",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "需要讀取相簿，才能讓你逐張滑動整理照片。照片只在手機上處理，不會上傳。",
          "savePhotosPermission": "需要相簿權限來整理照片。",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "scheme": "photoswipe",
    "experiments": {
      "typedRoutes": true
    }
  }
}
