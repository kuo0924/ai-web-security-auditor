# 擇一設定即可；兩個都沒設時，AI 顧問會自動降級成規則引擎的靜態修復指引
OPENAI_API_KEY=
# 可逗號列多個模型，429 / 5xx / 逾時時依序換下一個
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # 相容 OpenAI 格式的其他服務可改這裡
#
# 用 Gemini（Google AI Studio 金鑰，走 OpenAI 相容端點）時改成：
# OPENAI_API_KEY=你的 Gemini 金鑰
# OPENAI_MODEL=gemini-3.5-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max，越高越貴越仔細
ANTHROPIC_EFFORT=medium

# 供應商順序，逗號分隔；前面的失敗（額度用完、429、5xx、拒答）就換下一個。auto = anthropic,openai
LLM_PROVIDER=auto
# Claude 每日估算費用上限（美元），達到後自動改用下一個供應商或規則模式；0 = 不限制
LLM_DAILY_BUDGET_USD=2

# 每個來源 IP 每分鐘的檢測次數上限
SCAN_RATE_LIMIT=3
CONSULT_RATE_LIMIT=10

# 部署在反向代理（Nginx / Cloudflare）後面時設為 1，才會用 X-Forwarded-For 做限流
TRUST_PROXY=0
PORT=8000

# Cloudflare Web Analytics 的 beacon token（公開識別碼，不是機密）；留空就不載入分析腳本
CF_BEACON_TOKEN=

# 本機不要填，localhost 會被 Cloudflare 的 CORS 擋；正式站的 token 在 render.yaml
